# ==============================================================================
# INSIEDR SERVER - PRODUCTION ENVIRONMENT CONFIGURATION TEMPLATE
# ==============================================================================
# Copy this file to .env and configure appropriate values for your environment.

# --- 1. Cryptography & Envelope Security (CRITICAL) ---
# AES-256-GCM symmetric decryption key (64 hex characters / 32 bytes).
INSIEDR_AES_KEY=e548bcb6e1e7da40ccac2adeba65f34554458de520e9a0780f3a5f04f01a72d7
# Active crypto plugin scheme: 'aes-256-gcm' (production standard), 'hpke' (RFC 9180 draft)
INSIEDR_CRYPTO_SCHEME=aes-256-gcm
# Optional: Path to raw binary key file if not using hex environment variable
# INSIEDR_AES_KEY_PATH=/etc/insiedr/keys/server_aes.key
# HPKE private key (PEM or Base64 raw X25519) and primary key identifier
# INSIEDR_HPKE_PRIVATE_KEY=...
# INSIEDR_HPKE_KEY_ID=default
# INSIEDR_HPKE_KEYS_DIR=/etc/insiedr/hpke_keys/
# Legacy / Test crypto switches (KEEP FALSE IN PRODUCTION)
INSIEDR_ENABLE_FERNET=false
INSIEDR_ENABLE_PLAINTEXT_CRYPTO=false

# --- 2. Zero-Trust Authentication & RBAC (CRITICAL) ---
# Enforce authentication for all endpoints (True by default if keys are set; set explicitly)
INSIEDR_AUTH_ENFORCED=true
# Operator Admin Master API Key (used for SOC fleet actions and RBAC admin role)
INSIEDR_OPERATOR_API_KEY=insiedr_admin_supersecret_key_change_me
# Operator RBAC roles mapping: 'key1:role1,role2;key2:role3'
# Supported roles: 'admin', 'operator:containment', 'operator:remediation', 'operator:read', 'analyst'
INSIEDR_OPERATOR_ROLES=insiedr_admin_supersecret_key_change_me:admin;analyst_key_demo:analyst,operator:read
# Agent Identity & Token Registry:
# Pre-shared agent tokens mapped to bound Agent IDs (semicolon-separated 'agent_id:token' or JSON)
# Prevents spoofing - callers cannot present another agent's ID with a mismatched token.
INSIEDR_AGENT_TOKENS=agent-001:token_alpha_123;agent-002:token_beta_456
# Optional legacy shared token (only allowed if agent ID is embedded or verified)
# INSIEDR_AGENT_BEARER_TOKEN=shared_fleet_token

# --- 3. Server Networking & Ingestion Limits ---
PORT=5000
HOST=0.0.0.0
# Authoritative server IP / hostname that agents must retain network egress to during isolation
INSIEDR_SERVER_IP=127.0.0.1
# Enforce HTTPS scheme in headers (reject non-HTTPS in production behind TLS termination)
INSIEDR_REQUIRE_HTTPS=false
# Maximum allowable request body size (default: 10MB)
INSIEDR_MAX_REQUEST_BYTES=10485760
# Maximum collectors permitted in a single telemetry bundle
INSIEDR_MAX_COLLECTORS=100
# Allowed CORS origins (comma-separated, or '*' for open development)
INSIEDR_CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# --- 4. PostgreSQL Persistence & Transactional Outbox (Durable Authority) ---
# Full connection DSN or individual components.
#
# IMPORTANT — Docker Compose vs local-dev hostnames:
#   Local dev  → host = localhost  (values shown below)
#   Docker Compose → set host to the Compose service name, e.g. "db"
#                    either override in docker-compose.yml via environment:
#                      INSIEDR_DATABASE_DSN: postgresql://insiedr:insiedr_pass@db:5432/insiedr_db
#                    or duplicate this file as .env.docker with the correct hosts.
#   docker-compose.yml overrides the prefixed connection settings with service names.
#   The localhost values below apply only to local development.
INSIEDR_DATABASE_DSN=postgresql://insiedr:insiedr_pass@localhost:5432/insiedr_db
POSTGRES_USER=insiedr
POSTGRES_PASSWORD=insiedr_pass
POSTGRES_DB=insiedr_db
# Pool limit is per Uvicorn worker. Compose uses 2 workers * 12 = 24 of 40 connections.
INSIEDR_PG_POOL_MIN=2
INSIEDR_PG_POOL_MAX=12
# Automatically execute SQL migrations on ASGI startup
INSIEDR_MIGRATIONS_AUTO=true

# --- 5. Redis Task Queue & Fleet Command Cache ---
# Connection URL for high-throughput task queue and command caching.
# Docker Compose overrides this URL, including authentication, with the redis service.
INSIEDR_REDIS_URL=redis://localhost:6379/0
REDIS_PASSWORD=insiedr_redis_pass
INSIEDR_REDIS_SSL=false

# --- 6. ClickHouse Analytics & Reconciler Batcher ---
INSIEDR_CLICKHOUSE_ENABLED=true
# Docker Compose overrides the INSIEDR_CLICKHOUSE_* connection and query settings.
# Set this Compose credential to a unique password before deploying.
CLICKHOUSE_PASSWORD=insiedr_ch_pass
INSIEDR_CLICKHOUSE_HOST=localhost
INSIEDR_CLICKHOUSE_PORT=8123
INSIEDR_CLICKHOUSE_USER=default
INSIEDR_CLICKHOUSE_PASSWORD=insiedr_ch_pass
INSIEDR_CLICKHOUSE_DB=insiedr_analytics
INSIEDR_CLICKHOUSE_SECURE=false
# Query limits and safety timeouts
INSIEDR_CLICKHOUSE_QUERY_TIMEOUT=30
INSIEDR_CLICKHOUSE_MAX_MEMORY=2000000000
# Batch buffer bounds (flushed periodically or when limits are reached)
INSIEDR_CH_BATCH_MAX_ROWS=10000
INSIEDR_CH_BATCH_MAX_BYTES=10485760
INSIEDR_CH_BATCH_FLUSH_INTERVAL=2.0
# Dead-Letter Queue (DLQ) directory for failed or overflowed batch records
INSIEDR_DLQ_ENABLED=true
INSIEDR_DLQ_DIR=data/dlq
# Compose runs as UID/GID 10001. Prepare data/dlq ownership on the Linux host.
# See docs/DEPLOYMENT_12GB_HDD.md for storage monitoring and capacity limits.

# --- 7. Telemetry Retentions, Deduplication, & Interceptors ---
INSIEDR_EXPECTED_SCHEMA_VERSION=1.0
INSIEDR_MAX_PAYLOAD_AGE_DAYS=30
INSIEDR_REPLAY_WINDOW_HOURS=720
INSIEDR_STORE_PLAINTEXT_PAYLOADS=true
INSIEDR_PAYLOAD_RETENTION_DAYS=14
INSIEDR_FEATURE_RETENTION_DAYS=30

# --- 8. Machine Learning Pipeline & Baseline Tuning ---
INSIEDR_ENABLE_MODEL_PIPELINE=false
INSIEDR_ACTIVE_MODEL_VERSION=v2
INSIEDR_BASELINE_WINDOW_DAYS=3
INSIEDR_ZSCORE_CALIBRATION_THRESHOLD=10.0
INSIEDR_MODEL_INFERENCE_DIR=.
