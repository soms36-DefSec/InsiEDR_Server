# ==========================================
# INSIEDR SERVER - ENVIRONMENT CONFIGURATION
# ==========================================


# --- 2. Cryptography & Security (CRITICAL) ---
# The server MUST use the exact same AES-256 key to decrypt the payloads.
INSIEDR_AES_KEY=e548bcb6e1e7da40ccac2adeba65f34554458de520e9a0780f3a5f04f01a72d7

# The crypto scheme expected by the agent
INSIEDR_CRYPTO_SCHEME=aes-256-gcm

# Optional: Token-based authentication
INSIEDR_REQUIRE_AGENT_TOKEN=false

# --- 3. Server Networking ---
# The agent is configured to send data to HTTP port 80 or 5000 by default.
PORT=80
HOST=0.0.0.0
INSIEDR_REQUIRE_HTTPS=false

# --- 4. Payload Validation ---
# The agent strictly formats its payloads using this schema version.
INSIEDR_EXPECTED_SCHEMA_VERSION=1.0

# The server needs to know how far back in time to accept queued payloads.
INSIEDR_MAX_PAYLOAD_AGE_DAYS=30

# --- 5. Docker Database Defaults (from docker-compose) ---
POSTGRES_USER=insiedr
POSTGRES_PASSWORD=insiedr_pass
POSTGRES_DB=insiedr_db
REDIS_PASSWORD=insiedr_redis_pass
# INSIEDR_REDIS_URL configured dynamically via docker-compose (redis:6379)

# --- 6. Scalability & Retention Settings ---
INSIEDR_REPLAY_WINDOW_HOURS=720
INSIEDR_STORE_PLAINTEXT_PAYLOADS=true
INSIEDR_PAYLOAD_RETENTION_DAYS=14
INSIEDR_FEATURE_RETENTION_DAYS=30

# --- 7. Custom ML Calibration & Heuristics ---
INSIEDR_BASELINE_WINDOW_DAYS=3
INSIEDR_ZSCORE_CALIBRATION_THRESHOLD=10.0
INSIEDR_ENABLE_MODEL_PIPELINE=false

